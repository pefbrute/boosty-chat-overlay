{
  "manifest_version": 3,
  "key": "",
  "name": "Boosty Chat Connector (local)",
  "version": "0.5.1",
  "description": "Sends messages from an open Boosty chat to a local OBS overlay.",
  "permissions": ["alarms", "storage", "scripting", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:17369/*",
    "ws://127.0.0.1:17369/*",
    "https://boosty.to/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://boosty.to/*"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
