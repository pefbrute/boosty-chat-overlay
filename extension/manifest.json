{
  "manifest_version": 3,
  "name": "Boosty Chat Connector (local)",
  "version": "0.4.0",
  "description": "Sends messages from an open Boosty chat to a local OBS overlay.",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["http://127.0.0.1:17369/*", "ws://127.0.0.1:17369/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://boosty.to/*"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
