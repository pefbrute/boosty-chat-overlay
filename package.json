{
  "name": "boosty-chat-overlay",
  "version": "0.4.0",
  "private": true,
  "description": "Local Boosty chat overlay for OBS",
  "author": "Boosty Chat Overlay",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "start:server": "node server.js",
    "check": "node scripts/check-syntax.js",
    "test": "node scripts/test-server.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.derzko.boosty-chat-overlay",
    "productName": "Boosty Chat Overlay",
    "asar": true,
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "files": [
      "build/icon.png",
      "desktop/**/*",
      "overlay/**/*",
      "server.js",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Boosty Chat Overlay",
      "runAfterFinish": true,
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "electron@37.10.3": true
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.8"
  }
}
